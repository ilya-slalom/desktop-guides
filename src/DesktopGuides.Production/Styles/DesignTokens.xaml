<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="DesktopGuidesWindowBackgroundBrush"
                             Color="Transparent" />
            <StaticResource x:Key="DesktopGuidesCanvasBrush"
                            ResourceKey="SolidBackgroundFillColorBaseBrush" />
            <StaticResource x:Key="DesktopGuidesSurfaceBrush"
                            ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource x:Key="DesktopGuidesElevatedSurfaceBrush"
                            ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="DesktopGuidesBorderBrush"
                            ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="DesktopGuidesPrimaryTextBrush"
                            ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="DesktopGuidesSecondaryTextBrush"
                            ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="DesktopGuidesAccentBrush"
                            ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DesktopGuidesAccentTextBrush"
                            ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="DesktopGuidesSuccessBrush"
                            ResourceKey="SystemFillColorSuccessBrush" />
            <StaticResource x:Key="DesktopGuidesWarningBrush"
                            ResourceKey="SystemFillColorCautionBrush" />
            <StaticResource x:Key="DesktopGuidesDestructiveBrush"
                            ResourceKey="SystemFillColorCriticalBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="DesktopGuidesWindowBackgroundBrush"
                             Color="Transparent" />
            <StaticResource x:Key="DesktopGuidesCanvasBrush"
                            ResourceKey="SolidBackgroundFillColorBaseBrush" />
            <StaticResource x:Key="DesktopGuidesSurfaceBrush"
                            ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource x:Key="DesktopGuidesElevatedSurfaceBrush"
                            ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="DesktopGuidesBorderBrush"
                            ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="DesktopGuidesPrimaryTextBrush"
                            ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="DesktopGuidesSecondaryTextBrush"
                            ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="DesktopGuidesAccentBrush"
                            ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DesktopGuidesAccentTextBrush"
                            ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="DesktopGuidesSuccessBrush"
                            ResourceKey="SystemFillColorSuccessBrush" />
            <StaticResource x:Key="DesktopGuidesWarningBrush"
                            ResourceKey="SystemFillColorCautionBrush" />
            <StaticResource x:Key="DesktopGuidesDestructiveBrush"
                            ResourceKey="SystemFillColorCriticalBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="DesktopGuidesWindowBackgroundBrush"
                             Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DesktopGuidesCanvasBrush"
                             Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DesktopGuidesSurfaceBrush"
                             Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DesktopGuidesElevatedSurfaceBrush"
                             Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DesktopGuidesBorderBrush"
                             Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DesktopGuidesPrimaryTextBrush"
                             Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DesktopGuidesSecondaryTextBrush"
                             Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DesktopGuidesAccentBrush"
                             Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DesktopGuidesAccentTextBrush"
                             Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="DesktopGuidesSuccessBrush"
                             Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DesktopGuidesWarningBrush"
                             Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DesktopGuidesDestructiveBrush"
                             Color="{ThemeResource SystemColorHotlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="DesktopGuidesSpacing4">4</x:Double>
    <x:Double x:Key="DesktopGuidesSpacing8">8</x:Double>
    <x:Double x:Key="DesktopGuidesSpacing12">12</x:Double>
    <x:Double x:Key="DesktopGuidesSpacing16">16</x:Double>
    <x:Double x:Key="DesktopGuidesSpacing24">24</x:Double>
    <x:Double x:Key="DesktopGuidesSpacing32">32</x:Double>
    <x:Double x:Key="DesktopGuidesSpacing48">48</x:Double>
    <x:Double x:Key="DesktopGuidesNarrowBreakpoint">640</x:Double>
    <x:Double x:Key="DesktopGuidesWideBreakpoint">1000</x:Double>

    <Thickness x:Key="DesktopGuidesPagePadding">32,24</Thickness>
    <Thickness x:Key="DesktopGuidesPagePaddingWide">48,32</Thickness>
    <Thickness x:Key="DesktopGuidesPagePaddingNarrow">16,24,16,16</Thickness>
    <Thickness x:Key="DesktopGuidesSurfacePadding">20</Thickness>
    <Thickness x:Key="DesktopGuidesSurfacePaddingNarrow">16</Thickness>

    <CornerRadius x:Key="DesktopGuidesControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="DesktopGuidesSurfaceCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="DesktopGuidesHeroCornerRadius">12</CornerRadius>
</ResourceDictionary>
