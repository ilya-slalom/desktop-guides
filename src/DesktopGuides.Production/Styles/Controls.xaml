<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="DesktopGuidesPrimaryActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="16,6" />
    </Style>

    <Style x:Key="DesktopGuidesSecondaryActionButtonStyle"
           TargetType="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="16,6" />
    </Style>

    <Style x:Key="DesktopGuidesSurfaceStyle" TargetType="Border">
        <Setter Property="Background"
                Value="{ThemeResource DesktopGuidesSurfaceBrush}" />
        <Setter Property="BorderBrush"
                Value="{ThemeResource DesktopGuidesBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"
                Value="{StaticResource DesktopGuidesSurfaceCornerRadius}" />
        <Setter Property="Padding"
                Value="{StaticResource DesktopGuidesSurfacePadding}" />
    </Style>

    <Style x:Key="DesktopGuidesElevatedSurfaceStyle"
           TargetType="Border"
           BasedOn="{StaticResource DesktopGuidesSurfaceStyle}">
        <Setter Property="Background"
                Value="{ThemeResource DesktopGuidesElevatedSurfaceBrush}" />
    </Style>

    <Style x:Key="DesktopGuidesListStyle" TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="DesktopGuidesStatusBarStyle" TargetType="Border">
        <Setter Property="Background"
                Value="{ThemeResource DesktopGuidesSurfaceBrush}" />
        <Setter Property="BorderBrush"
                Value="{ThemeResource DesktopGuidesBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
</ResourceDictionary>
