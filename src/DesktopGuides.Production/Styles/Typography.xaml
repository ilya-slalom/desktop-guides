<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="DesktopGuidesPageTitleStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Foreground"
                Value="{ThemeResource DesktopGuidesPrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
    </Style>

    <Style x:Key="DesktopGuidesSectionTitleStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Foreground"
                Value="{ThemeResource DesktopGuidesPrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>

    <Style x:Key="DesktopGuidesBodyStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground"
                Value="{ThemeResource DesktopGuidesPrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DesktopGuidesSecondaryBodyStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground"
                Value="{ThemeResource DesktopGuidesSecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DesktopGuidesMetadataStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground"
                Value="{ThemeResource DesktopGuidesSecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DesktopGuidesEmptyTitleStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground"
                Value="{ThemeResource DesktopGuidesPrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>

    <Style x:Key="DesktopGuidesStatusTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground"
                Value="{ThemeResource DesktopGuidesSecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DesktopGuidesDialogHeadingStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource DesktopGuidesEmptyTitleStyle}" />

    <Style x:Key="DesktopGuidesEncodingSampleStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource DesktopGuidesSecondaryBodyStyle}">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="Clip" />
        <Setter Property="IsTextSelectionEnabled" Value="False" />
    </Style>

    <!-- T14.4: TXT keeps Consolas; T08.3's line metrics depend on it. -->
    <FontFamily x:Key="DesktopGuidesReaderMonoFontFamily">Consolas</FontFamily>

    <Style x:Key="DesktopGuidesSettingsSectionStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground"
                Value="{ThemeResource DesktopGuidesPrimaryTextBrush}" />
        <Setter Property="Margin"
                Value="{StaticResource DesktopGuidesSettingsSectionMargin}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>
</ResourceDictionary>
