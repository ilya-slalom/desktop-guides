<Window
    x:Class="DesktopGuides.Production.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:DesktopGuides.Production">
    <Grid x:Name="ShellRoot"
          Background="{ThemeResource DesktopGuidesWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="SolidCanvas"
                Grid.RowSpan="2"
                Background="{ThemeResource DesktopGuidesCanvasBrush}"
                Visibility="Collapsed"
                AutomationProperties.AccessibilityView="Raw" />

        <TitleBar x:Name="AppTitleBar"
                  Title="Desktop Guides"
                  Subtitle="Offline game guide library"
                  IsBackButtonVisible="True"
                  IsBackButtonEnabled="False"
                  IsPaneToggleButtonVisible="True"
                  BackRequested="TitleBarBackRequested"
                  PaneToggleRequested="TitleBarPaneToggleRequested"
                  AutomationProperties.AutomationId="AppTitleBar">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE82D;" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView x:Name="Navigation"
                    Grid.Row="1"
                    PaneDisplayMode="Auto"
                    CompactPaneLength="48"
                    OpenPaneLength="240"
                    IsBackButtonVisible="Collapsed"
                    IsPaneToggleButtonVisible="False"
                    IsSettingsVisible="True"
                    Background="{ThemeResource DesktopGuidesWindowBackgroundBrush}"
                    AutomationProperties.AutomationId="Navigation"
                    ItemInvoked="NavigationInvoked">
        <NavigationView.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="SystemColorWindowColorBrush" />
                        <StaticResource x:Key="NavigationViewContentGridBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </NavigationView.Resources>
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="LibraryItem"
                                Content="Library"
                                Icon="Home"
                                AutomationProperties.AutomationId="LibraryNavigation" />
        </NavigationView.MenuItems>

        <Grid x:Name="ShellContent"
              Padding="{StaticResource DesktopGuidesPagePadding}"
              HorizontalAlignment="Stretch"
              Background="{ThemeResource DesktopGuidesWindowBackgroundBrush}"
              AutomationProperties.AutomationId="ShellContent"
              AutomationProperties.Name="Page content"
              AutomationProperties.AccessibilityView="Raw"
              SizeChanged="ShellContentSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <InfoBar x:Name="ShellStatusInfoBar"
                     Style="{StaticResource DesktopGuidesStatusInfoBarStyle}"
                     Margin="0,0,0,16"
                     IsOpen="True"
                     Severity="Informational"
                     Message="Opening library…"
                     AutomationProperties.AutomationId="ShellStatus"
                     AutomationProperties.Name="Opening library…"
                     AutomationProperties.LiveSetting="Polite" />

            <Grid x:Name="LibraryPanel"
                  Grid.Row="1"
                  RowSpacing="{StaticResource DesktopGuidesSpacing16}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="{StaticResource DesktopGuidesSpacing16}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Library"
                               Style="{StaticResource DesktopGuidesPageTitleStyle}"
                               AutomationProperties.AutomationId="LibraryHeading" />
                    <Button x:Name="AddGameButton"
                            Grid.Column="1"
                            Content="Add game"
                            Style="{StaticResource DesktopGuidesPrimaryActionButtonStyle}"
                            VerticalAlignment="Center"
                            Click="AddGameClicked"
                            AutomationProperties.AutomationId="AddGameButton" />
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="Keep the guides for every game together and ready offline."
                           Style="{StaticResource DesktopGuidesSecondaryBodyStyle}" />

                <Button x:Name="ResumeButton"
                        Grid.Row="2"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed"
                        Style="{StaticResource DesktopGuidesSecondaryActionButtonStyle}"
                        Click="ResumeClicked"
                        AutomationProperties.AutomationId="ResumeGuide" />

                <Grid Grid.Row="3">
                    <Border x:Name="LibraryEmptyState"
                            Style="{StaticResource DesktopGuidesEmptyStateStyle}"
                            AutomationProperties.AutomationId="LibraryEmptyState">
                        <StackPanel Spacing="{StaticResource DesktopGuidesSpacing8}">
                            <FontIcon Glyph="&#xE82D;"
                                      FontSize="24"
                                      HorizontalAlignment="Left"
                                      Foreground="{ThemeResource DesktopGuidesAccentBrush}"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="LibraryEmpty"
                                       Text="No games in your library."
                                       Style="{StaticResource DesktopGuidesEmptyTitleStyle}"
                                       AutomationProperties.AutomationId="LibraryEmpty" />
                            <TextBlock Text="Add a game to organize walkthroughs and reference guides."
                                       Style="{StaticResource DesktopGuidesSecondaryBodyStyle}" />
                        </StackPanel>
                    </Border>
                    <ListView x:Name="GameList"
                              SelectionMode="Single"
                              Style="{StaticResource DesktopGuidesListStyle}"
                              ItemTemplate="{StaticResource DesktopGuidesArtworkRowTemplate}"
                              SelectionChanged="GameSelected"
                              AutomationProperties.AutomationId="GameList"
                              AutomationProperties.Name="Games" />
                </Grid>
            </Grid>

            <Grid x:Name="GamePanel"
                  Grid.Row="1"
                  RowSpacing="{StaticResource DesktopGuidesSpacing16}"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="{StaticResource DesktopGuidesSpacing16}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="GameHeading"
                               Style="{StaticResource DesktopGuidesPageTitleStyle}"
                               AutomationProperties.AutomationId="GameHeading" />
                    <Button x:Name="RefreshMetadataButton"
                            Grid.Column="1"
                            Content="Refresh metadata"
                            Style="{StaticResource DesktopGuidesSecondaryActionButtonStyle}"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Click="RefreshMetadataClicked"
                            AutomationProperties.AutomationId="RefreshMetadataButton" />
                    <Button x:Name="EditGameButton"
                            Grid.Column="2"
                            Content="Edit game"
                            Style="{StaticResource DesktopGuidesSecondaryActionButtonStyle}"
                            VerticalAlignment="Center"
                            Click="EditGameClicked"
                            AutomationProperties.AutomationId="EditGameButton" />
                </Grid>

                <Border x:Name="GameMetadataSurface"
                        Grid.Row="1"
                        Style="{StaticResource DesktopGuidesSurfaceStyle}"
                        AutomationProperties.AutomationId="GameMetadataSurface">
                    <Grid ColumnSpacing="{StaticResource DesktopGuidesSpacing16}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="GameCoverFrame"
                                Style="{StaticResource DesktopGuidesCoverFrameStyle}"
                                Visibility="Collapsed">
                            <Image x:Name="GameCover"
                                   Stretch="UniformToFill"
                                   AutomationProperties.Name="Cover art"
                                   AutomationProperties.AutomationId="GameCover" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Spacing="{StaticResource DesktopGuidesSpacing8}">
                            <TextBlock x:Name="GamePlatform"
                                       Style="{StaticResource DesktopGuidesBodyStyle}"
                                       AutomationProperties.AutomationId="GamePlatform" />
                            <ScrollViewer x:Name="GameNotesScroll"
                                          MaxHeight="96"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          AutomationProperties.AutomationId="GameNotesScroll"
                                          AutomationProperties.Name="Game notes">
                                <TextBlock x:Name="GameNotes"
                                           Style="{StaticResource DesktopGuidesSecondaryBodyStyle}"
                                           IsTextSelectionEnabled="True"
                                           AutomationProperties.AutomationId="GameNotes" />
                            </ScrollViewer>
                            <StackPanel x:Name="GameProviderDetails"
                                        Spacing="{StaticResource DesktopGuidesSpacing8}"
                                        Visibility="Collapsed">
                                <local:AutomationGroup AutomationProperties.AutomationId="GameFacts">
                                    <toolkit:MetadataControl x:Name="GameFacts" Style="{StaticResource DesktopGuidesFactsStyle}" />
                                </local:AutomationGroup>
                                <ScrollViewer MaxHeight="120"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              AutomationProperties.Name="Game summary">
                                    <TextBlock x:Name="GameSummary"
                                               Style="{StaticResource DesktopGuidesSecondaryBodyStyle}"
                                               TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True"
                                               AutomationProperties.AutomationId="GameSummary" />
                                </ScrollViewer>
                                <TextBlock x:Name="GameGenres"
                                           Style="{StaticResource DesktopGuidesMetadataStyle}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="GameGenres" />
                                <TextBlock x:Name="GameCompanies"
                                           Style="{StaticResource DesktopGuidesMetadataStyle}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="GameCompanies" />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="{StaticResource DesktopGuidesSpacing12}">
                                    <TextBlock x:Name="GameAttribution"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource DesktopGuidesMetadataStyle}"
                                               AutomationProperties.AutomationId="GameAttribution" />
                                    <HyperlinkButton x:Name="GameProviderLink"
                                                     Content="View on IGDB"
                                                     Visibility="Collapsed"
                                                     AutomationProperties.AutomationId="GameProviderLink" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2"
                      ColumnSpacing="{StaticResource DesktopGuidesSpacing16}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Guides"
                               Style="{StaticResource DesktopGuidesSectionTitleStyle}" />
                    <Button x:Name="OpenSelectedGuideButton"
                            Grid.Column="1"
                            Content="Open selected guide"
                            Visibility="Collapsed"
                            Style="{StaticResource DesktopGuidesSecondaryActionButtonStyle}"
                            Click="OpenSelectedGuideClicked"
                            AutomationProperties.AutomationId="OpenSelectedGuide" />
                </Grid>

                <Grid Grid.Row="3">
                    <Border x:Name="GameEmptyState"
                            Style="{StaticResource DesktopGuidesEmptyStateStyle}"
                            AutomationProperties.AutomationId="GameGuideEmptyState">
                        <StackPanel Spacing="{StaticResource DesktopGuidesSpacing8}">
                            <TextBlock x:Name="GameEmpty"
                                       Text="No guides in this game."
                                       Style="{StaticResource DesktopGuidesEmptyTitleStyle}"
                                       AutomationProperties.AutomationId="GameEmpty" />
                            <TextBlock Text="Guides you import for this game will appear here."
                                       Style="{StaticResource DesktopGuidesSecondaryBodyStyle}" />
                        </StackPanel>
                    </Border>
                    <ListView x:Name="GuideList"
                              DisplayMemberPath="Title"
                              SelectionMode="Single"
                              Style="{StaticResource DesktopGuidesListStyle}"
                              SelectionChanged="GuideSelected"
                              AutomationProperties.AutomationId="GuideList"
                              AutomationProperties.Name="Guides" />
                </Grid>
            </Grid>

            <Grid x:Name="ReaderPanel"
                  Grid.Row="1"
                  RowSpacing="{StaticResource DesktopGuidesSpacing12}"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button x:Name="ReaderBackButton"
                        Content="Back to game"
                        HorizontalAlignment="Left"
                        Style="{StaticResource DesktopGuidesSecondaryActionButtonStyle}"
                        Click="ReaderBackClicked"
                        AutomationProperties.AutomationId="ReaderBackToGame" />

                <Grid Grid.Row="1"
                      ColumnSpacing="{StaticResource DesktopGuidesSpacing16}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="{StaticResource DesktopGuidesSpacing4}">
                        <TextBlock x:Name="ReaderHeading"
                                   Style="{StaticResource DesktopGuidesPageTitleStyle}"
                                   AutomationProperties.AutomationId="ReaderHeading" />
                        <TextBlock x:Name="ReaderGameName"
                                   Style="{StaticResource DesktopGuidesSecondaryBodyStyle}"
                                   AutomationProperties.AutomationId="ReaderGameName" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Padding="10,4"
                            VerticalAlignment="Top"
                            Background="{ThemeResource DesktopGuidesSurfaceBrush}"
                            BorderBrush="{ThemeResource DesktopGuidesBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource DesktopGuidesControlCornerRadius}">
                        <TextBlock x:Name="ReaderFormat"
                                   Style="{StaticResource DesktopGuidesMetadataStyle}"
                                   AutomationProperties.AutomationId="ReaderFormat" />
                    </Border>
                </Grid>

                <local:ReaderToolbar x:Name="ReaderActions"
                                     Grid.Row="2" />

                <Border Grid.Row="3"
                        Style="{StaticResource DesktopGuidesElevatedSurfaceStyle}"
                        Background="{ThemeResource DesktopGuidesReadingSurfaceBrush}">
                    <ContentControl x:Name="ReaderSurface">
                        <TextBlock x:Name="ReaderPlaceholder"
                                   Text="Reading this guide is unavailable in this preview."
                                   Style="{StaticResource DesktopGuidesSecondaryBodyStyle}"
                                   AutomationProperties.AutomationId="ReaderPlaceholder" />
                    </ContentControl>
                </Border>
            </Grid>

            <Grid x:Name="SettingsPanel"
                  Grid.Row="1"
                  RowSpacing="{StaticResource DesktopGuidesSpacing16}"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Settings"
                           Style="{StaticResource DesktopGuidesPageTitleStyle}"
                           AutomationProperties.AutomationId="SettingsHeading" />
                <TextBlock Grid.Row="1"
                           Text="Manage how Desktop Guides stores and presents your library."
                           Style="{StaticResource DesktopGuidesSecondaryBodyStyle}" />
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              VerticalContentAlignment="Top">
                    <StackPanel Spacing="{StaticResource DesktopGuidesSpacing4}">
                        <toolkit:SettingsCard
                            x:Name="LibraryStorageSettingsCard"
                            Header="Library storage"
                            Description="Your library is stored on this device."
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            IsClickEnabled="False"
                            AutomationProperties.AutomationId="LibraryStorageSettingsCard"
                            AutomationProperties.Name="Library storage. Your library is stored on this device.">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8F1;"
                                          AutomationProperties.AccessibilityView="Raw" />
                            </toolkit:SettingsCard.HeaderIcon>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                            x:Name="WindowMaterialSettingsCard"
                            Header="Window background"
                            Description="Choose how much of your desktop shows behind the app."
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="WindowMaterialSettingsCard"
                            AutomationProperties.Name="Window background. Choose how much of your desktop shows behind the app.">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE790;"
                                          AutomationProperties.AccessibilityView="Raw" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ComboBox x:Name="WindowMaterialSelector"
                                      MinWidth="160"
                                      IsEnabled="False"
                                      SelectionChanged="WindowMaterialSelectionChanged"
                                      AutomationProperties.AutomationId="WindowMaterialSelector"
                                      AutomationProperties.Name="Window background">
                                <ComboBoxItem Content="Mica" Tag="Mica" />
                                <ComboBoxItem Content="Acrylic" Tag="Acrylic" />
                                <ComboBoxItem Content="Solid" Tag="Solid" />
                            </ComboBox>
                        </toolkit:SettingsCard>
                        <local:ProviderSettingsCard x:Name="ProviderSettings" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        </NavigationView>
    </Grid>
</Window>
