<ContentDialog
    x:Class="DesktopGuides.Production.GameEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonClick="SaveClicked"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    AutomationProperties.AutomationId="GameEditorDialog">
    <StackPanel MaxWidth="440"
                Spacing="{StaticResource DesktopGuidesSpacing16}">
        <InfoBar x:Name="EditorNotice"
                 IsOpen="False"
                 IsClosable="False"
                 Severity="Informational"
                 AutomationProperties.AutomationId="GameEditorNotice">
            <InfoBar.ActionButton>
                <HyperlinkButton x:Name="EditorNoticeSettingsLink"
                                 Content="Open Settings"
                                 Click="OpenSettingsClicked"
                                 AutomationProperties.AutomationId="GameEditorNoticeSettingsLink" />
            </InfoBar.ActionButton>
        </InfoBar>
        <StackPanel Spacing="{StaticResource DesktopGuidesSpacing4}">
            <TextBox x:Name="GameTitleInput"
                     Header="Title"
                     TextChanged="InputChanged"
                     AutomationProperties.AutomationId="GameTitleInput" />
            <TextBlock x:Name="TitleFeedback"
                       Style="{StaticResource DesktopGuidesMetadataStyle}"
                       AutomationProperties.AutomationId="GameTitleFeedback"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <StackPanel Spacing="{StaticResource DesktopGuidesSpacing4}">
            <TextBox x:Name="GamePlatformInput"
                     Header="Platform (optional)"
                     TextChanged="InputChanged"
                     AutomationProperties.AutomationId="GamePlatformInput" />
            <TextBlock x:Name="PlatformFeedback"
                       Style="{StaticResource DesktopGuidesMetadataStyle}"
                       AutomationProperties.AutomationId="GamePlatformFeedback" />
        </StackPanel>
        <StackPanel Spacing="{StaticResource DesktopGuidesSpacing4}">
            <TextBox x:Name="GameNotesInput"
                     Header="Notes (optional)"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="96"
                     TextChanged="InputChanged"
                     AutomationProperties.AutomationId="GameNotesInput" />
            <TextBlock x:Name="NotesFeedback"
                       Style="{StaticResource DesktopGuidesMetadataStyle}"
                       AutomationProperties.AutomationId="GameNotesFeedback" />
        </StackPanel>
        <InfoBar x:Name="SaveError"
                 IsOpen="False"
                 IsClosable="False"
                 Severity="Error"
                 AutomationProperties.AutomationId="GameSaveError" />
    </StackPanel>
</ContentDialog>
